[Unit]
Description=Trigger the cold copy when the backup drive is unlocked
Documentation=https://github.com/crunchtools/pbs

[Path]
# The device-mapper node, not the mount point. It appears the moment the LUKS
# volume is unlocked -- wherever udisks then decides to mount it -- and it goes
# away again when ColdCopy.service re-locks the drive, which re-arms this unit.
#
# There is deliberately no .timer alongside this. A timer would fire on a locked
# drive, find nothing to do and succeed: a check that passes by accident. The
# thing that catches a drive nobody plugged in is Cold Copy Freshness on gloval.
PathExists=/dev/mapper/luks-e692da8c-d6fe-4809-9f01-8f686ace1149
Unit=ColdCopy.service

[Install]
WantedBy=default.target
