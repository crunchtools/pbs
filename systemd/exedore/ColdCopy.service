[Unit]
Description=Monthly on-site copy of pCloud to Exedore's NVMe (pbs ColdCopy)
Documentation=https://github.com/crunchtools/pbs
# Exedore is a Crunchtools-owned host, not a CSB, so none of breetai's
# unlock-is-the-trigger machinery applies (RT#1628). The target is a TPM-unlocked
# LUKS volume on the internal NVMe, mounted at boot, and ColdCopy.timer runs this
# monthly. The breetai objection to a timer -- it fires on a locked drive and
# succeeds -- is answered by the mountpoint check below, which FAILS the run when
# the volume is not there. Cold Copy Freshness on gloval is still the backstop.
#
# The 4 TB USB drive is no longer this unit's target: it is the offline copy,
# unplugged, refreshed once a year by hand (see host-config.txt). Offline is the
# point -- a stolen pCloud token or a compromised Exedore cannot reach it.
RequiresMountsFor=/var/mnt/onsite
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The first pass can be the whole 733 GiB; systemd must not call that a hang.
TimeoutStartSec=0
Nice=10
IOSchedulingClass=idle
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/onsite
# Clear a dead leftover container; a running one makes the run fail on the
# name, which is loud but never kills live work. Same as the gloval units.
ExecStartPre=-/usr/bin/podman rm pbs-cold-copy
# The block inhibitor is what the rhel10-bootc-server update interlock
# (RT#1594) defers on, so an image update cannot reboot through a sync.
ExecStart=/usr/bin/systemd-inhibit \
    --what=shutdown \
    --mode=block \
    --who=pbs \
    --why="Cold copy in flight" \
    /usr/bin/podman run --rm \
    --pull=newer \
    --security-opt label=disable \
    --name pbs-cold-copy \
    -v /etc/rclone.conf:/etc/rclone.conf:ro \
    -v /var/mnt/onsite:/data \
    --tmpfs /tmp:rw \
    --network=host \
    -e COLD_HOST=exedore.dc2.crunchtools.com \
    quay.io/crunchtools/pbs:latest \
    -B -m ColdCopy -d /data
# ColdCopy moves changed and deleted files to /data/attic/<date> instead of
# destroying them, so a ransomware pass or bad delete in pCloud is not mirrored
# straight over the only on-site copy. On a 1.8 TB volume the attic cannot grow
# forever; 90 days is three monthly runs of history. Runs only after a clean sync.
ExecStartPost=/usr/bin/sh -c 'test -d /var/mnt/onsite/attic || exit 0; exec find /var/mnt/onsite/attic -mindepth 1 -maxdepth 1 -type d -mtime +90 -exec rm -rf {} +'
