[Unit]
Description=Weekly cold copy of pCloud to the 4 TB drive
Documentation=https://github.com/crunchtools/pbs

[Timer]
# Sunday morning, after gloval's Saturday ServerBackups rotation (08:00 UTC,
# hours long) has landed in pCloud. Local time on Exedore is America/New_York.
OnCalendar=Sun *-*-* 06:00:00
Persistent=true

[Install]
WantedBy=timers.target
