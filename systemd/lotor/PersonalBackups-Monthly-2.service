[Unit]
Description=Personal pCloud rotation (Monthly-2): pcloud to pcloud via rclone
RefuseManualStart=no
RefuseManualStop=no

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-inhibit \
    --what=shutdown \
    --mode=block \
    --who=pbs \
    --why="pCloud rotation Files/Monthly-2 in flight" \
    /usr/bin/podman run --rm \
    --pull=newer \
    --security-opt label=disable \
    --name pbs-personal-monthly-2 \
    -v /etc/rclone.conf:/etc/rclone.conf:ro \
    --tmpfs /tmp:rw \
    --network=host \
    quay.io/crunchtools/pbs:latest \
    -B -m Files -r Monthly-2
